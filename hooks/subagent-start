#!/usr/bin/env bash
# SubagentStart hook: SessionStart context never reaches subagents, so without
# this every dispatched agent runs Ascension-unaware. Injects a compact subagent
# brief rather than the full activation protocol, which is written for the
# parent session (user-facing skills, orchestration, the whole map).
# Scoped by the matcher in hooks.json.

set -euo pipefail

cat <<'EOF'
{
  "hookSpecificOutput": {
    "hookEventName": "SubagentStart",
    "additionalContext": "<ascension-subagent>\nYou were dispatched by a session running Ascension. Its skills are available through the Skill tool, e.g. Skill(\"ascension:fault-diagnosis\").\n\nBefore acting on your task, invoke any skill that applies to it:\n- Writing or changing code: ascension:minimalism, ascension:test-first, ascension:pattern-matching\n- Something is broken: ascension:fault-diagnosis\n- A question spans many files or a large payload: ascension:think-in-code\n- About to report the work as done or passing: ascension:completion-gate\n\nThe parent session owns the decisions that need the user: rationale, grilling, intent-discovery, merge-protocol. Do not run those; you cannot ask the user. If your task is ambiguous, say so in your report instead of guessing. Report in the format your brief asks for.\n</ascension-subagent>"
  }
}
EOF

exit 0
